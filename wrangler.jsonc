{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  // remote: true — Vectorize has no local emulation, so without it `astro dev`
  // queries an empty local stub and every answer degrades to the out-of-scope
  // reply. There is no fallback matcher any more (adr-04), so dev must exercise
  // the real index. It is also what lets `bun run index:corpus` write to the
  // real index from a dev server without an API token.
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // New index for KodexBar. The legacy `kodex-vector-index` was created at 384
  // dimensions for the English-only @cf/baai/bge-small-en-v1.5; KodexBar embeds
  // with the multilingual @cf/baai/bge-m3, whose dimension count differs.
  // Vectorize indexes are fixed-dimension and cannot be migrated (adr-10).
  //
  // One-time setup — use the dimension count that `bun run index:corpus`
  // reports, and create the metadata index so `filter: { lang }` works:
  //   bunx wrangler vectorize create kodexbar-corpus --dimensions=<N> --metric=cosine
  //   bunx wrangler vectorize create-metadata-index kodexbar-corpus --property-name=lang --type=string
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "kodexbar-corpus",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "c8f72c7b92cf427ea9633033e8d49fac"
    }
  ],
  // The apex is the front door; home.kodexarg.com is kept as an alias so old
  // links and the deploy history stay valid.
  //
  // kodexarg.com and www.kodexarg.com previously served a separate Astro site
  // (a `Terminal` component that never existed in this repository). That page
  // was retired deliberately — taking the hostnames over as custom domains
  // moves their DNS onto this Worker, so the old project is no longer reachable
  // at either name.
  "routes": [
    {
      "pattern": "kodexarg.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kodexarg.com",
      "custom_domain": true
    },
    {
      "pattern": "home.kodexarg.com",
      "custom_domain": true
    }
  ]
}
