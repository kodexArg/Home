{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "kodexbar-corpus",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "c8f72c7b92cf427ea9633033e8d49fac"
    }
  ],
  "routes": [
    {
      "pattern": "kodexarg.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kodexarg.com",
      "custom_domain": true
    },
    {
      "pattern": "home.kodexarg.com",
      "custom_domain": true
    }
  ]
}
