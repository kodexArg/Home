{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homepage",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "kodex-vector-index"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "c8f72c7b92cf427ea9633033e8d49fac"
    }
  ]
}
