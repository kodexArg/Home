---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.svelte';
import KodexBar from '../components/KodexBar.svelte';
---

<Base title="kodexArg — Gabriel Cavedal">
  <header>
    <Wordmark static size="0.95rem" href="https://cv.kodexarg.com" />
  </header>

  <main aria-label="KodexBar">
    <KodexBar client:only="svelte" />
  </main>
</Base>

<style>
  header {
    position: absolute;
    inset: 0 0 auto 0;
    padding: 1.4rem 1.8rem 1.1rem;
    background: transparent;
    z-index: 3;
    width: max-content;
    user-select: none;
    -webkit-user-select: none;
  }

  main {
    position: relative;
    height: 100dvh;
    overflow: hidden;
  }
</style>
